
# JWT Secret (generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-key-here

# AWS SES Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region
EMAIL_FROM=your-email-from
EMAIL_FROM_NAME=your-email-from-name

RADICALE_URL=http://localhost:5232
RADICALE_TOKEN=secret-token

# Database
DB_FILE_NAME=local.db

# Mock Configuration (for development/testing)
MOCK_SMS=true
MOCK_EMAIL=true

# Templates
ENABLE_TEMPLATES=true
DEFAULT_TEMPLATE=f

# Show disclaimer box on the login page (for demo/test deployments)
SHOW_DISCLAIMER=false

# Enable the tri-state privacy UI (storage + third-party API-sharing choices)
# When false, only the binary "Keep private" checkboxes are shown and any
# previously stored api_disallow_* settings are preserved untouched.
# Defaults to true when unset.
ENABLE_API_SHARING=true
